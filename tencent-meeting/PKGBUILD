pkgname=tencent-meeting
_pkgname=wemeet
pkgver=3.26.10.401
_pkgver_arm=3.26.10.401
_pkgver_loong=3.26.10.401
_x86_md5=72e0e0023e1d1e6d4123fba28821aea1
_arm_md5=c06d6bc4a3370dbfb2f43bbc6ff8969e
_loong_md5=399aded330e344aa1327064170be86e8
pkgrel=1
pkgdesc="Tencent Meeting (腾讯会议 / WeMeet) Linux client with Wayland compatibility and Bubblewrap sandbox"
arch=('x86_64' 'aarch64' 'loong64')
url="https://meeting.tencent.com/"
license=('LicenseRef-Proprietary')
provides=('wemeet' 'tencent-meeting' 'wemeet-bin')
conflicts=('wemeet' 'wemeet-bin')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'bash'
    'gcc-libs'
    'glibc'
    'hicolor-icon-theme'
    'libglvnd'
    'libpulse'
    'libx11'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxinerama'
    'libxrandr'
    'libyuv'
    'nss'
    'openssl'
    'qt5-base'
    'qt5-declarative'
    'qt5-svg'
    'qt5-x11extras'
    'systemd-libs'
    'zlib'
)
optdepends=(
    'bubblewrap: Privacy sandbox isolation and dark mode text color fix'
    'qt5-wayland: Native Wayland support'
)
makedepends=(
    'patchelf'
)
options=(!strip !debug)

source=(
    "meeting.sh"
    "tencent-meeting.desktop"
    "wrap.c"
    "LICENSE"
)
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::https://updatecdn.meeting.qq.com/cos/${_x86_md5}/TencentMeeting_0300000000_${pkgver}_x86_64_default.publish.officialwebsite.deb")
source_aarch64=("${pkgname}-${_pkgver_arm}-aarch64.deb::https://updatecdn.meeting.qq.com/cos/${_arm_md5}/TencentMeeting_0300000000_${_pkgver_arm}_arm64_default.publish.officialwebsite.deb")
source_loong64=("${pkgname}-${_pkgver_loong}-loong64.deb::https://updatecdn.meeting.qq.com/cos/${_loong_md5}/TencentMeeting_0300000000_${_pkgver_loong}_loongarch64_default.publish.officialwebsite.deb")

noextract=(
    "${pkgname}-${pkgver}-x86_64.deb"
    "${pkgname}-${_pkgver_arm}-aarch64.deb"
    "${pkgname}-${_pkgver_loong}-loong64.deb"
)

sha256sums=(
    '27099a22a16fc730ac7363d76437d15c2382534a84adc531f3fff3c6a1f07908'
    '274309c44a6984565a14f310fd077178c43cdaa662ce3ba23f169db68d7ecf75'
