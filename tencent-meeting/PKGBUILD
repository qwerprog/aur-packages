)
sha256sums_aarch64=(
    '5b9d04d5b9aa24b3c353b158d2a34a3e5875cfc03d133d4673e36b1d0841c202'
)
sha256sums_loong64=(
    '2746b5f411500de9d95a3f3db565d251c27b924388b254e788f840398fffe00e'
)

prepare() {
    local _deb_file
    case "${CARCH}" in
        x86_64) _deb_file="${pkgname}-${pkgver}-x86_64.deb" ;;
        aarch64) _deb_file="${pkgname}-${_pkgver_arm}-aarch64.deb" ;;
        loong64) _deb_file="${pkgname}-${_pkgver_loong}-loong64.deb" ;;
    esac

    bsdtar -xf "${_deb_file}" data.tar.xz
    tar xpf data.tar.xz

    # Patch qt.conf Prefix
    sed -i "s|^Prefix.*|Prefix = /usr/lib/${_pkgname}|" "opt/${_pkgname}/bin/qt.conf"

    # Set clean rpath on main binary and modules to use /usr/lib/wemeet
    patchelf --set-rpath '$ORIGIN:/usr/lib/wemeet' "opt/${_pkgname}/bin/wemeetapp"
    find "opt/${_pkgname}/bin/modules" -type f -name '*.so' | xargs -I {} patchelf --set-rpath '$ORIGIN:/usr/lib/wemeet' {}
}

build() {
    cd "${srcdir}"
    read -ra openssl_args < <(pkgconf --libs openssl)
    read -ra libpulse_args < <(pkgconf --cflags --libs libpulse)
    "${CC:-cc}" ${CFLAGS} -Wall -Wextra -fPIC -shared "${openssl_args[@]}" "${libpulse_args[@]}" -o libwemeetwrap.so wrap.c -D WRAP_FORCE_SINK_HARDWARE
}

package() {
    # Extract desktop icons
    install -Dm644 "${srcdir}/opt/${_pkgname}/wemeet.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${pkgname}.svg"
    ln -sf "${pkgname}.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/wemeet.svg"
    ln -sf "${pkgname}.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/wemeetapp.svg"

    for res in 16 32 64 128 256; do
        if [[ -f "${srcdir}/opt/${_pkgname}/icons/hicolor/${res}x${res}/mimetypes/wemeetapp.png" ]]; then
            install -Dm644 "${srcdir}/opt/${_pkgname}/icons/hicolor/${res}x${res}/mimetypes/wemeetapp.png" \
                "${pkgdir}/usr/share/icons/hicolor/${res}x${res}/apps/${pkgname}.png"
            ln -sf "${pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/${res}x${res}/apps/wemeet.png"
            ln -sf "${pkgname}.png" "${pkgdir}/usr/share/icons/hicolor/${res}x${res}/apps/wemeetapp.png"
        fi
    done

    # Install libraries into /usr/lib/wemeet
    install -dm755 "${pkgdir}/usr/lib/${_pkgname}"
    install -Dm755 "${srcdir}/opt/${_pkgname}/lib"/lib{desktop_common,crash_guard,ImSDK,nxui*,qt_*,ui*,wemeet*,xcast*,xnn*}.so \
        -t "${pkgdir}/usr/lib/${_pkgname}"
    if [[ -f "${srcdir}/opt/${_pkgname}/lib/libcrbase.so" ]]; then
        install -Dm755 "${srcdir}/opt/${_pkgname}/lib/libcrbase.so" -t "${pkgdir}/usr/lib/${_pkgname}"
    fi
    cp -r "${srcdir}/opt/${_pkgname}"/{plugins,resources,translations} "${pkgdir}/usr/lib/${_pkgname}/"
    cp -a "${srcdir}/opt/${_pkgname}/lib"/lib{Qt,icu}* "${pkgdir}/usr/lib/${_pkgname}/"

    # Patch rpath for all libraries in /usr/lib/wemeet
    find "${pkgdir}/usr/lib/${_pkgname}" -type f -name '*.so*' | xargs -I {} patchelf --set-rpath '$ORIGIN:/usr/lib/wemeet' {}

    # Install wrapper library
    install -Dm755 "${srcdir}/libwemeetwrap.so" "${pkgdir}/usr/lib/${_pkgname}/libwemeetwrap.so"

    # Install application binaries to /opt/wemeet
    install -dm755 "${pkgdir}/opt/${_pkgname}"
    cp -r "${srcdir}/opt/${_pkgname}/bin" "${pkgdir}/opt/${_pkgname}/"
    ln -sf raw/xcast.conf "${pkgdir}/opt/${_pkgname}/bin/xcast.conf"

    # Install launcher scripts
    install -Dm755 "${srcdir}/meeting.sh" "${pkgdir}/usr/bin/${pkgname}"
    ln -sf "${pkgname}" "${pkgdir}/usr/bin/wemeet"
    ln -sf "${pkgname}" "${pkgdir}/usr/bin/${pkgname}-x11"
    ln -sf "${pkgname}" "${pkgdir}/usr/bin/wemeet-x11"

    # Install desktop entry
    install -Dm644 "${srcdir}/tencent-meeting.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
    ln -sf "${pkgname}.desktop" "${pkgdir}/usr/share/applications/wemeet.desktop"
    ln -sf "${pkgname}.desktop" "${pkgdir}/usr/share/applications/wemeetapp.desktop"

    # Install license
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
